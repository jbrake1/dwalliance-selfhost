#!/bin/bash
# Render the nginx site for DW Alliance from /etc/dwalliance/dwalliance.conf.
# HTTP on :80 for every host (default_server). For each certificate listed in
# /etc/dwalliance/https-domains ("certname host1 host2 ..."), an HTTPS server on :443
# and an HTTP->HTTPS redirect for those hosts (ACME challenges stay on HTTP).
# Safe to re-run. Usage: dw-render-nginx [--no-reload]
set -euo pipefail
CONF=/etc/dwalliance/dwalliance.conf
[ -r "$CONF" ] || { echo "missing $CONF (run install.sh)" >&2; exit 1; }
# shellcheck disable=SC1090
. "$CONF"
SRC_DIR=${DW_SRC_DIR:-/opt/dwalliance/current}
SNIP=/etc/nginx/snippets/dwalliance-app.conf
SITE=/etc/nginx/sites-available/dwalliance
LIST=/etc/dwalliance/https-domains
mkdir -p /etc/nginx/snippets /var/www/acme
sed "s#__PHP_SOCK__#${DW_PHP_SOCK}#g" "$SRC_DIR/config/nginx/dwalliance-app.conf" > "$SNIP.tmp" && mv "$SNIP.tmp" "$SNIP"

https_blocks=""
map_lines=""
if [ -s "$LIST" ]; then
  while read -r cert hosts; do
    [ -n "${cert:-}" ] || continue
    case "$cert" in \#*) continue ;; esac
    if [ ! -s "/etc/letsencrypt/live/$cert/fullchain.pem" ]; then
      echo "skip https for $cert: no certificate yet" >&2; continue
    fi
    for h in $hosts; do map_lines+="    $h 1;"$'\n'; done
    https_blocks+="
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name $hosts;
    ssl_certificate /etc/letsencrypt/live/$cert/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$cert/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:dwssl:10m;
    include $SNIP;
}
"
  done < "$LIST"
fi

cat > "$SITE.tmp" <<NGX
# Generated by dw-render-nginx. Do not edit; change /etc/dwalliance and re-run it.
map \$host \$dw_force_https {
    default 0;
${map_lines}}
# Hosts that keep the /BRAND/... API routing (lib/DwDomain.php isAppHost); every other host is a claimed site.
map \$host \$dw_is_app {
    default 0;
    "" 1;
    ${DW_APP_HOST} 1;
    localhost 1;
    ~^[0-9.]+\$ 1;
    ~^\\[ 1;
    ~\\.lan\$ 1;
}
# A site's "/" is its index.html (on the hosted service the front proxy does this rewrite).
map "\$dw_is_app:\$uri" \$dw_root_index {
    "0:/" 1;
    default 0;
}
map \$uri \$dw_acme {
    ~^/\.well-known/acme-challenge/ 1;
    default 0;
}
map "\$dw_force_https:\$dw_acme" \$dw_redirect_https {
    "1:0" 1;
    default 0;
}
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type text/plain;
    }
    if (\$dw_redirect_https) {
        return 301 https://\$host\$request_uri;
    }
    include $SNIP;
}
${https_blocks}
NGX
mv "$SITE.tmp" "$SITE"
ln -sfn "$SITE" /etc/nginx/sites-enabled/dwalliance
rm -f /etc/nginx/sites-enabled/default
nginx -t -q
if [ "${1:-}" != "--no-reload" ]; then
  if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then systemctl reload nginx || systemctl restart nginx; else nginx -s reload 2>/dev/null || nginx; fi
fi
