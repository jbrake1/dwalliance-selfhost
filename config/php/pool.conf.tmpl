; DW Alliance PHP-FPM pool. Rendered by install.sh from /etc/dwalliance/dwalliance.env.
; Do not edit by hand: change /etc/dwalliance/dwalliance.env and re-run install.sh.
[dwalliance]
user = www-data
group = www-data
listen = __PHP_SOCK__
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
pm = dynamic
pm.max_children = __PM_MAX__
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 4
pm.max_requests = 500
clear_env = yes
catch_workers_output = yes
